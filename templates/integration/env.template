# Smart Sites Admin - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# REQUIRED
# ===========================================

# Admin panel password
ADMIN_PASSWORD=your-secure-password-here

# ===========================================
# GITHUB STORAGE (Recommended for Production)
# ===========================================

# GitHub Personal Access Token with repo permissions
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub repository owner (username or organization)
GITHUB_OWNER=your-username

# GitHub repository name
GITHUB_REPO=your-repo-name

# Branch to commit content changes to (default: main)
GITHUB_BRANCH=main

# ===========================================
# IMAGE UPLOADS (Vercel Blob)
# ===========================================

# Vercel Blob read/write token
# Get one from your Vercel project settings → Storage → Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxxxxxxxxxx

# ===========================================
# OPTIONAL
# ===========================================

# Base URL of your site (for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=https://your-site.com
