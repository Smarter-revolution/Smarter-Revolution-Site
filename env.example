# Smart Sites Lite Environment Variables
# Copy this file to .env.local for development

# ============================================
# ADMIN AUTHENTICATION
# ============================================
# Password for accessing the /admin panel
# Choose a strong password and share securely with clients
ADMIN_PASSWORD=your-secure-password-here

# ============================================
# GITHUB INTEGRATION (for auto-commit on save)
# ============================================
# Personal Access Token with 'repo' scope
# Generate at: GitHub → Settings → Developer Settings → Personal Access Tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub repository owner (username or organization)
GITHUB_OWNER=your-github-username

# GitHub repository name
GITHUB_REPO=your-repo-name

# Branch to commit to (optional, defaults to 'main')
GITHUB_BRANCH=main

# ============================================
# VERCEL BLOB STORAGE (for image uploads)
# ============================================
# This token is auto-configured when you create a Blob store in Vercel
# In Vercel dashboard: Project → Storage → Create Database → Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxx

# ============================================
# NOTES
# ============================================
# 1. For local development, GitHub integration is optional
#    - Without it, saves go to local files only
#    - With it, saves commit to GitHub and trigger Vercel rebuild
#
# 2. For production on Vercel:
#    - Add these variables in Project Settings → Environment Variables
#    - BLOB_READ_WRITE_TOKEN is auto-added when you create a Blob store
#
# 3. Security:
#    - Never commit .env.local to version control
#    - Use strong, unique passwords
#    - Rotate tokens periodically
