# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# ENVIRONMENT FILES - CRITICAL SECURITY
# =============================================================================
# All .env files MUST be ignored except .env.example
.env
.env.*
.env.local
.env.development
.env.production
.env.test
.env.vercel
.env.vercel.*
!.env.example

# Backup env files
*.env.backup
*.env.bak

# =============================================================================
# VERCEL
# =============================================================================
.vercel

# =============================================================================
# TYPESCRIPT
# =============================================================================
*.tsbuildinfo
next-env.d.ts

# =============================================================================
# DATA & LOGS
# =============================================================================
/data

# Security-related files that should never be committed
*.key
*.pem
*.crt
secrets/
credentials/
